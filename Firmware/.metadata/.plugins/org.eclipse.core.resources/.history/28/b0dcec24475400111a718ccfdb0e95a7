		case MOVE_FORWARD_1:
			move_forward(&move, &encoder_left, 86.0, 20.0);
			status->status_actual = TURN_1;
			break;
		case TURN_1:
			if (move.status == STOP) {
			HAL_Delay(500);
			turn(&move, &encoder_left, sens*M_PI/2, 10.0);
